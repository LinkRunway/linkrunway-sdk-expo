{
  "name": "@linkrunway/sdk-expo",
  "version": "0.2.0",
  "description": "LinkRunway SDK for expo.",
  "license": "MIT",
  "author": "Kimeur Labs, LLC <support@linkrunway.com>",
  "homepage": "https://github.com/LinkRunway/linkrunway-sdk-expo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinkRunway/linkrunway-sdk-expo.git"
  },
  "bugs": {
    "url": "https://github.com/LinkRunway/linkrunway-sdk-expo/issues",
    "email": "support@linkrunway.com"
  },
  "keywords": [
    "linkrunway",
    "attribution",
    "deep-links",
    "expo"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "app.plugin.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup --entry.index src/index.ts --entry.plugin src/plugin/index.ts --format esm,cjs --dts --clean --target es2020",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@linkrunway/sdk-react-native": "https://github.com/LinkRunway/linkrunway-sdk-react-native/releases/download/0.2.0/linkrunway-sdk-react-native-0.2.0.tgz"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@expo/config-plugins": "*"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "@expo/config-plugins": "57.0.11"
  }
}
